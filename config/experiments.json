{
  "seed": 42,
  "n_jobs": 4,
  "validation_season": 2024,
  "smoothing": 50.0,
  "accepted_mapping_grades": ["확정", "높음"],
  "baseline_experiment": "v1__lgbm_base",
  "save_validation_models": false,
  "modes": {
    "quick": {
      "max_rows_per_season": 5000,
      "max_trackman_rows": 300000
    },
    "full": {
      "max_rows_per_season": null,
      "max_trackman_rows": null
    }
  },
  "feature_sets": {
    "raw_minimal": {
      "description": "공식 원본 피처 + 모델 실행에 필요한 최소 자료형·결측 처리",
      "input_view": "raw_minimal",
      "preprocessing_stage": "raw_minimal",
      "blocks": [],
      "drop_patterns": []
    },
    "v1": {
      "description": "기존 V1 155개 피처",
      "input_view": "v1",
      "preprocessing_stage": "v1",
      "blocks": [],
      "drop_patterns": []
    },
    "v1_asof": {
      "description": "V1 + 공식 asof 추세·대조 13개",
      "blocks": ["asof_trend"],
      "drop_patterns": []
    },
    "v1_asof_threat_ball_only": {
      "description": "V1 + asof 추세 + 타자위협도×볼비율 1개",
      "blocks": ["asof_trend", "batter_threat_interactions"],
      "drop_patterns": [
        "hand_match",
        "success_interact",
        "reverse_x_middle",
        "threat_x_reverse",
        "threat_x_middle"
      ]
    },
    "v1_asof_threat_no_ball": {
      "description": "V1 + asof 추세 + 타자위협 교차피처 중 threat_x_ball 제외",
      "blocks": ["asof_trend", "batter_threat_interactions"],
      "drop_patterns": ["threat_x_ball"]
    },
    "v1_asof_threat": {
      "description": "V1 + asof 추세 + 타자위협 교차피처 6개",
      "blocks": ["asof_trend", "batter_threat_interactions"],
      "drop_patterns": []
    },
    "v1_asof_situation": {
      "description": "V1 + asof 추세 + 상황·압박 상호작용",
      "blocks": ["asof_trend", "situation"],
      "drop_patterns": []
    },
    "v1_all_rowwise": {
      "description": "V1 + asof + 상황 + 구종 구성 + 표본 신뢰도",
      "input_view": "v1",
      "preprocessing_stage": "v1_all",
      "blocks": ["asof_trend", "situation", "pitchmix", "reliability"],
      "drop_patterns": []
    },
    "v1_all_threat": {
      "description": "V1 전체 row-wise 피처 + 타자 위협도 교차피처 6개",
      "input_view": "v1",
      "preprocessing_stage": "v1_all_threat",
      "blocks": [
        "asof_trend",
        "situation",
        "pitchmix",
        "reliability",
        "batter_threat_interactions"
      ],
      "drop_patterns": []
    },
    "v1_all_no_ids": {
      "description": "전체 row-wise 피처에서 투수·타자 ID 제거",
      "blocks": ["asof_trend", "situation", "pitchmix", "reliability"],
      "drop_patterns": ["pitcher_id", "batter_id"]
    },
    "v1_all_no_trackman": {
      "description": "전체 row-wise 피처에서 Trackman 계열 제거",
      "blocks": ["asof_trend", "situation", "pitchmix", "reliability"],
      "drop_patterns": ["tm_*", "trackman_*"]
    }
  },
  "models": {
    "constant": {
      "type": "constant",
      "description": "학습 성공률만 예측하는 기준선",
      "params": {}
    },
    "lgbm_base": {
      "type": "lightgbm",
      "description": "V1과 동일한 기본 LightGBM",
      "params": {
        "n_estimators": 1500,
        "early_stopping_rounds": 100,
        "learning_rate": 0.025,
        "num_leaves": 31,
        "max_depth": -1,
        "min_child_samples": 300,
        "subsample": 0.85,
        "subsample_freq": 1,
        "colsample_bytree": 0.85,
        "reg_alpha": 0.2,
        "reg_lambda": 3.0,
        "max_bin": 255
      }
    },
    "lgbm_regularized": {
      "type": "lightgbm",
      "description": "표본이 많은 데이터에 맞춘 보수적 LightGBM",
