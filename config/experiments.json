        "learning_rate": 0.06,
        "max_iter": 350,
        "max_leaf_nodes": 31,
        "min_samples_leaf": 250,
        "l2_regularization": 3.0
      }
    },
    "extra_trees": {
      "type": "extra_trees",
      "description": "다양성이 큰 Extra Trees",
      "params": {
        "n_estimators": 350,
        "max_depth": 18,
        "min_samples_leaf": 50,
        "max_features": 0.65,
        "bootstrap": true,
        "max_samples": 0.45
      }
    },
    "xgboost": {
