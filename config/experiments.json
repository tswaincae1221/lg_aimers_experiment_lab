        "early_stopping_rounds": 100,
        "learning_rate": 0.025,
        "num_leaves": 63,
        "max_depth": -1,
        "min_child_samples": 400,
        "subsample": 0.85,
        "subsample_freq": 1,
        "colsample_bytree": 0.9,
        "reg_alpha": 0.3,
        "reg_lambda": 6.0,
        "max_bin": 255
      }
    },
    "logistic": {
